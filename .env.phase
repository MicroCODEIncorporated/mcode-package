#
# Current Mode - working offsite in a MicroCODE Windows NT environment
NODE_ENV=beta
#
# otherwise “docker compose up” command takes the directory name as the app name,
# make sure this name is all *lowercase* as it is used for Docker Container Names.
COMPOSE_PROJECT_NAME=mcode-project
#
# eMITS - Backend
APP_NAME=eMITS
#
PRODUCTION_DOMAIN=project.mcode.com
#
# eMITS - Remote API Proxy Server
PROXY_SERVER_URL=http://localhost:8080
PROXY_SERVER_HOST=127.0.0.1
PROXY_SERVER_PORT=8080
PROXY_SERVER_AUTOSTART=true
#
#
# Redis - Realtime Cache - project.mcode.com
REDIS_IP=127.0.0.1  # '_HOST' crashes REDIS connection
REDIS_PORT=9736 # default = 6379
REDIS_URL=redis://127.0.0.1:9736
REDIS_USER=mcode_redis_user
REDIS_PASSWORD=mcode-redis-password
#
# MicroCODE - UI Server
UI_SERVER_URL=http://localhost:5000
UI_SERVER_DIR=
UI_SERVER_HOST=127.0.0.1
UI_SERVER_PORT=5000
UI_SERVER_MAXD='7d'
UI_SERVER_MAXS='604800'
UI_SERVER_API='/api'
UI_SERVER_DB='PostgreSQL';
UI_SERVER_DBAPI='MicroCODE';
UI_SERVER_NAME='MCX-PROJECT-UI'
UI_SERVER_NAMESPACE='MCX-PROJECT-UI';
#
#
# PostgreSQL - Database - project.mcode.com
DB_SERVER_HOST=127.0.0.1
DB_SERVER_PORT=5432
DB_SERVER_URL=http://127.0.0.1:5432
DB_SERVER_API='/db'
#
# PostgreSQL - Credentials
DB_SERVER_CLIENT=pg
DB_SERVER_NAME='MCX-PROJECT-DB'
DB_SERVER_USER=mcode_db_user
DB_SERVER_PASSWORD=mcode_db_password
#
# MicroCODE CACHE options - App Cache
CACHE_DEFAULT=false  # cache disabled for on-the-fly updates of the UI
#
# Authorization - JWT
TOKEN_SECRET=
CRYPTO_SECRET=*
SESSION_SECRET=*
#
# Email - for SUPPORT and NOTIFICATIONS
SUPPORT_EMAIL=timothy.mcguire@mcode.com
#
# Logging - for API and EVENT logs
GENERATE_SOURCEMAP=false
ENABLE_API_LOGS=true
STORE_EVENT_LOGS=true
#
#